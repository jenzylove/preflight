# Template only. Copy to .env and fill in there — .env is gitignored.
# Never put a real credential in this file: it is committed to a public repo.

# ---- Parallel (requirement retrieval) --------------------------------------
PARALLEL_API_KEY=

# ---- Google Cloud -----------------------------------------------------------
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GCS_BUCKET=

# Vertex AI / Gemini Enterprise Agent Platform
VERTEX_MODEL=gemini-2.5-pro

# ---- Firebase Authentication ------------------------------------------------
FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=

# ---- Database ---------------------------------------------------------------
# Local development runs Postgres in Docker; Cloud SQL replaces this in Gate 7.
DATABASE_URL=postgresql+psycopg://preflight:preflight@localhost:5432/preflight

# ---- Limits (cost control, see PRD 17) --------------------------------------
MAX_UPLOAD_BYTES=2147483648
MAX_JOB_SECONDS=900
SIGNED_URL_TTL_SECONDS=900
DELIVERY_TOKEN_TTL_HOURS=168
